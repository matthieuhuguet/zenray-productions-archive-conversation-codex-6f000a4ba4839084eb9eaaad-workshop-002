#!/bin/zsh
# 19 October 2026, 17:53 CEST: Rebuild the editable Maccy memory fork without changing the original application.
set -eu
project_root="${0:A:h:h}"
xcodebuild -project "$project_root/MaccySource/Maccy.xcodeproj" -scheme Maccy -configuration Release -destination 'platform=macOS' -derivedDataPath "$project_root/Build/Derived" -clonedSourcePackagesDirPath "$project_root/Build/Packages" -skipPackagePluginValidation CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO CODE_SIGN_ENTITLEMENTS= PRODUCT_BUNDLE_IDENTIFIER=st.zenray.clipboard ENABLE_APP_SANDBOX=NO build > "$project_root/Build/Build.log" 2>&1

#!/usr/bin/env python3
# 19 October 2026, 17:52 CEST: Preserve Maccy and import its live history into an independent local app.
import json, os, pathlib, plistlib, shutil, sqlite3, subprocess
root = pathlib.Path(__file__).resolve().parent.parent
app = pathlib.Path('/Applications/ZenRayClipboard.app')
build = root/'Build/Derived/Build/Products/Release/Maccy.app'
assert build.exists()
assert not app.exists(), 'Destination already exists; do not overwrite a running build.'
subprocess.run(['ditto',str(build),str(app)],check=True)
info = app/'Contents/Info.plist'
d = plistlib.loads(info.read_bytes())
d['CFBundleDisplayName'] = 'ZenRay Clipboard'
d['CFBundleName'] = 'ZenRay Clipboard'
d['CFBundleIdentifier'] = 'st.zenray.clipboard'
d['SUEnableAutomaticChecks'] = False
d.pop('SUFeedURL',None)
info.write_bytes(plistlib.dumps(d))
subprocess.run(['codesign','--force','--deep','--sign','-',str(app)],check=True)
subprocess.run(['codesign','--verify','--deep','--strict',str(app)],check=True)
home=pathlib.Path.home()
original=home/'Library/Containers/org.p0deje.Maccy/Data/Library'
source=original/'Application Support/Maccy/Storage.sqlite'
folder=home/'Library/Application Support/ZenRayClipboard'
folder.mkdir(mode=0o700,exist_ok=True)
target=folder/'Storage.sqlite'
assert not target.exists(), 'Import only once.'
read=sqlite3.connect(source.as_uri()+'?mode=ro',uri=True)
write=sqlite3.connect(target)
read.backup(write)
original_count=read.execute('select count(*) from ZHISTORYITEM').fetchone()[0]
original_bytes=read.execute('select sum(length(ZVALUE)) from ZHISTORYITEMCONTENT where ZITEM in (select Z_PK from ZHISTORYITEM)').fetchone()[0]
write.execute('delete from ZHISTORYITEMCONTENT where ZITEM is null or ZITEM not in (select Z_PK from ZHISTORYITEM)')
write.commit()
write.execute('vacuum')
assert write.execute('pragma integrity_check').fetchone()[0]=='ok'
assert write.execute('select count(*) from ZHISTORYITEM').fetchone()[0]==original_count
assert write.execute('select sum(length(ZVALUE)) from ZHISTORYITEMCONTENT').fetchone()[0]==original_bytes
os.chmod(target,0o600)
preferences=plistlib.loads((original/'Preferences/org.p0deje.Maccy.plist').read_bytes())
preferences['SUEnableAutomaticChecks']=False
preferences['SUAutomaticallyUpdate']=False
preferences['previewMaxPixels']=2048.0
preferences['thumbnailScale']=2.0
preferences['releasePreviewsWhenHidden']=True
preference_path=folder/'ImportedPreferences.plist'
preference_path.write_bytes(plistlib.dumps(preferences))
os.chmod(preference_path,0o600)
subprocess.run(['defaults','import','st.zenray.clipboard',str(preference_path)],check=True)
proof={'importedItems':original_count,'liveContentBytes':original_bytes,'originalDatabaseBytes':source.stat().st_size,'newDatabaseBytes':target.stat().st_size,'integrity':'ok','originalUntouched':True}
(root/'Build/ImportProof.json').write_text(json.dumps(proof,indent=2)+'\n')
print(json.dumps(proof))
